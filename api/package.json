{
  "name": "my-api",
  "version": "1.0.0",
  "description": "Express API generated by ExpressKit",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "db:migrate": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
