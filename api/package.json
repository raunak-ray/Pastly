{
  "name": "my-api",
  "version": "1.0.0",
  "description": "Express API generated by ExpressKit",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "oxlint": "^1.90.0",
    "@biomejs/biome": "^2.6.4"
  }
}
